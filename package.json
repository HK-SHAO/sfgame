{
  "name": "sfgame",
  "private": true,
  "workspaces": [
    "sfgame-web",
    "cloudflare"
  ],
  "scripts": {
    "build": "bun run --cwd sfgame-web build",
    "dev": "bun run --cwd sfgame-web dev",
    "test": "bun run --cwd sfgame-web test",
    "check": "bun run --cwd sfgame-web check",
    "deploy": "bun run check && bun run --cwd cloudflare deploy"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
