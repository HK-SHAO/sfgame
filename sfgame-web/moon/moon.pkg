// 外部宿主（JS）直调的数值库：无 _start、零 import，导出面即全部接口。
// 内存静态定型（内核缓冲全为静态 FixedArray，运行期零分配）：min=max 把容量钉死在三内核总需求之上，
// 运行期增长会 detach 宿主缓存的 typed view，故从配置层面禁止（与 AS stub runtime 同契约）
pkgtype(kind: "foreign_library")

import {
  "moonbitlang/core/math",
  "moonbitlang/core/cmp",
}

import {
  "moonbitlang/core/test",
} for "test"

import {
  "moonbitlang/core/test",
} for "wbtest"

options(
  link: {
    "wasm": {
      "exports": [
        "canary_buf",
        "canary_len",
        "canary_set",
        "canary_get",
        // 流体内核（导出名与 assembly 引擎对齐，宿主契约不变）
        "fluid_init:init",
        "clear",
        "set_ambient:setAmbient",
        "rebuild_solid:rebuildSolid",
        "add_heat:addHeat",
        "add_force:addForce",
        "step",
        "sample_velocity:sampleVelocity",
        "out_x:outX",
        "out_y:outY",
        "sample_temp:sampleTemp",
        "field_u:fieldU",
        "field_v:fieldV",
        "field_t:fieldT",
        "solid_buf:solidBuf",
        "field_fx_u:fieldFxU",
        "field_fx_v:fieldFxV",
        // 顶点批内核（导出名与 assembly 引擎对齐）
        "b_capacity:bCapacity",
        "b_pts_cap:bPtsCap",
        "b_fade_cap:bFadeCap",
        "b_data:bData",
        "b_pts_buf:bPtsBuf",
        "b_fade_buf:bFadeBuf",
        "b_tracer_buf:bTracerBuf",
        "b_tracer_cap:bTracerCap",
        "b_tracer_stride:bTracerStride",
        "b_count:bCount",
        "b_reset:bReset",
        "b_tri:bTri",
        "b_rect:bRect",
        "b_rect_vgrad:bRectVGrad",
        "b_stroke:bStroke",
        "b_polyline_fade:bPolylineFade",
        "b_terrain_field_buf:bTerrainFieldBuf",
        "b_terrain_field_cap:bTerrainFieldCap",
        "b_terrain_field:bTerrainField",
        "b_terrain_draw:bTerrainDraw",
        "b_tracers:bTracers",
        "b_disc:bDisc",
        "b_disc_grad:bDiscGrad",
        "b_ring:bRing",
        "b_arc:bArc",
        "b_dash_ring:bDashRing",
        // 示踪粒子内核（导出名与 assembly 引擎对齐）
        "tracers_init:tracersInit",
        "tracers_step:tracersStep",
        "t_time:tTime",
        "t_x_buf:tXBuf",
        "t_y_buf:tYBuf",
        "t_life_buf:tLifeBuf",
        "t_max_life_buf:tMaxLifeBuf",
        "t_trail_x_buf:tTrailXBuf",
        "t_trail_y_buf:tTrailYBuf",
        "t_trail_t_buf:tTrailTBuf",
        "t_trail_n_buf:tTrailNBuf",
        "t_sdf_buf:tSdfBuf",
        "t_sdf_cap:tSdfCap",
        "t_src_buf:tSrcBuf",
        "t_src_cap:tSrcCap",
      ],
      "export-memory-name": "memory",
      // 384 页 = 24MB：三内核静态缓冲约 8.5MB + 运行期 FixedArray 头/GC 堆余量，一次钉死
      "memory-limits": { "min": 384, "max": 384 },
    },
  },
)
