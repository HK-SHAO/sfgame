{
  "name": "sfgame-web",
  "private": true,
  "version": "0.0.0",
  "description": "烧风 · 用温度创造风",
  "author": "烧风 (HK-SHAO)",
  "type": "module",
  "scripts": {
    "dev": "bun run build:wasm && vite",
    "build": "tsc -b && bun run build:wasm && vite build",
    "preview": "vite preview",
    "test": "bun run build:wasm && vitest run",
    "typecheck": "tsc -b",
    "build:wasm": "asc assembly/main.ts -o src/sim/wasm/sfsim.wasm -O3 --noAssert --runtime stub --enable simd",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "assemblyscript": "^0.28.20",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
