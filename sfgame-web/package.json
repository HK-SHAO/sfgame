  "author": {
    "name": "HK-SHAO",
    "email": "hk-shao@outlook.com"
  },
  "type": "module",
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js",
    "build": "bun run typecheck && bun run test && bun vite build",
