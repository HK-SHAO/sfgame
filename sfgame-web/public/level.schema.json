{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sf.game.shao.fun/level.schema.json",
  "title": "烧风关卡（协议 v1）",
  "description": "烧风关卡协议 v1：放置热/冷源造风，送纸飞机抵达站点。坐标 y 向下；goals/fixed/fans 须落在世界内，spawn 可在画布外 ±20 单位；流体网格（含外扩边距）宽×高须在 16..256 × 16..160 格，cell 须在 0.5..1.5。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "tagline", "win", "world", "terrain", "budget", "spawn", "goals"],
  "properties": {
    "$schema": { "type": "string", "description": "编辑器补全提示（可选），仅 IDE 使用" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$", "description": "关卡标识（小写 slug：字母/数字/连字符，≤32 字符，全局唯一）" },
    "name": { "type": "string", "minLength": 1, "description": "关卡名" },
    "tagline": { "type": "string", "minLength": 1, "description": "副标题（选关页展示）" },
    "win": {
      "type": "object",
      "required": ["title", "text"],
      "description": "过关结算",
      "properties": {
        "title": { "type": "string", "minLength": 1, "description": "过关标题" },
        "text": { "type": "string", "minLength": 1, "description": "过关文案" }
      }
    },
    "world": {
      "type": "object",
      "required": ["w", "h", "cell"],
      "description": "画布与流体网格（含 10 单位外扩边距后，宽×高须在 16..256 × 16..160 格）",
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0, "description": "画布宽（世界单位）" },
        "h": { "type": "number", "exclusiveMinimum": 0, "description": "画布高（世界单位）" },
        "cell": { "type": "number", "minimum": 0.5, "maximum": 1.5, "description": "网格单元尺寸（物理粒度下限与网格容量上限双界，极端尺寸由关卡校验精确拦截）" }
      }
    },
    "terrain": {
      "type": "object",
      "required": ["sdf"],
      "description": "地形 SDF（>0 空气 / <0 实体，y 向下）",
      "properties": { "sdf": { "type": "string", "minLength": 1, "description": "SDF 表达式（高度场 H(x)−y 或圆/盒/胶囊原语组合）" } }
    },
    "budget": {
      "type": "object",
      "required": ["hot", "cold"],
      "description": "热/冷源预算（资源上限）",
      "properties": {
        "hot": { "type": "integer", "minimum": 0, "description": "热源数量" },
        "cold": { "type": "integer", "minimum": 0, "description": "冷源数量" }
      }
    },
    "spawn": {
      "type": "object",
      "required": ["x"],
      "description": "出生位置与初速度（可在画布外飞入）",
      "properties": {
        "x": { "type": "number", "description": "出生位置 x" },
        "y": { "type": "number", "description": "出生位置 y（缺省 = 地表）" },
        "vx": { "type": "number", "description": "初速度 x 分量（缺省 0）" },
        "vy": { "type": "number", "description": "初速度 y 分量（缺省 0）" }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "description": "抵达圆站点，全部抵达过即过关（顺序无关）",
      "items": {
        "type": "object",
        "required": ["x", "r"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "description": "站点中心 x" },
          "y": { "type": "number", "exclusiveMinimum": 0, "description": "锚点 y（杆底落点，检测圆在其上 GOAL_LIFT 处）；缺省 = 该 x 处地表高度（洞穴内需显式指定）" },
          "r": { "type": "number", "exclusiveMinimum": 0, "maximum": 15, "description": "抵达半径" }
        }
      }
    },
    "balloons": {
      "type": "array",
      "maxItems": 40,
      "description": "气球障碍阵（不是目标）：锚点固定、随当地风微摆，飞机撞入即爆并受反推；可作弹床/风信标等玩家可利用机制",
      "items": {
        "type": "object",
        "required": ["x", "y", "r"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "description": "锚点 x" },
          "y": { "type": "number", "exclusiveMinimum": 0, "description": "锚点 y" },
          "r": { "type": "number", "exclusiveMinimum": 0, "maximum": 5, "description": "半径" }
        }
      }
    },
    "balloonGate": {
      "type": "boolean",
      "description": "玩法模式：全部气球击破后 goals 才揭示并判定（缺省关闭；开启需非空 balloons）"
    },
    "ambient": {
      "type": "object",
      "required": ["x", "y"],
      "description": "常风与可选温度偏置、潮汐",
      "properties": {
        "x": { "type": "number", "description": "常风 x 分量" },
        "y": { "type": "number", "description": "常风 y 分量" },
        "temp": { "type": "number", "minimum": -10, "maximum": 10, "description": "环境温度偏置（正 = 全域上升，负 = 下沉）；|temp|≥9 单极世界" },
        "tide": {
          "type": "object",
          "required": ["period"],
          "description": "潮汐（常风的周期振荡）",
          "properties": {
            "period": { "type": "number", "exclusiveMinimum": 0, "description": "周期" },
            "phase": { "type": "number", "description": "初相位（弧度，缺省 0）" },
            "ampX": { "type": "number", "description": "x 振幅（缺省 0）" },
            "ampY": { "type": "number", "description": "y 振幅（缺省 0）" }
          }
        }
      }
    },
    "fixed": {
      "type": "array",
      "maxItems": 8,
      "description": "关卡自带源（不可移除、不占预算）",
      "items": {
        "type": "object",
        "required": ["x", "y", "kind"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "description": "位置 x" },
          "y": { "type": "number", "exclusiveMinimum": 0, "description": "位置 y" },
          "kind": { "enum": ["hot", "cold"], "description": "类型（hot = 热源，cold = 冷源）" },
          "power": { "type": "number", "exclusiveMinimum": 0, "description": "强度倍数（缺省 1）" }
        }
      }
    },
    "fans": {
      "type": "array",
      "maxItems": 8,
      "description": "风扇（定向气流）",
      "items": {
        "type": "object",
        "required": ["x", "y", "dir", "power"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "description": "位置 x" },
          "y": { "type": "number", "exclusiveMinimum": 0, "description": "位置 y" },
          "dir": { "type": "number", "description": "朝向（弧度，0 = +x 方向，y 向下）" },
          "power": { "type": "number", "exclusiveMinimum": 0, "description": "注入风速" },
          "swing": { "type": "number", "minimum": 0, "maximum": 3.141592653589793, "description": "摆幅（±弧度；0 = 不摆）" },
          "period": { "type": "number", "exclusiveMinimum": 0, "description": "摆动周期（与 swing 成对出现）" }
        }
      }
    }
  }
}
